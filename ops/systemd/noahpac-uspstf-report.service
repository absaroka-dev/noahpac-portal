[Unit]
Description=Email Noah PA-C weekly USPSTF refresh report
After=noahpac-uspstf-update.service
OnFailure=noahpac-monitor-failure@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/noahpac-monitor.env
ExecStart=/usr/bin/python3 /var/www/noahpac-portal/scripts/send-monitoring-report.py --report-prefix uspstf-report --title "USPSTF Screener Weekly Refresh" --expected='[["uspstf","USPSTF Screener","https://noahpac.com/screener/"]]'
StandardOutput=journal
StandardError=journal
